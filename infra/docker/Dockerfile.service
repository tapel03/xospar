# Build from the repo root:  docker build -f infra/docker/Dockerfile.service -t edgeline-backend .
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend ./backend
COPY packages ./packages
RUN npm ci --omit=dev --workspace @edgeline/backend --include-workspace-root
WORKDIR /app/backend
ENV NODE_ENV=production
EXPOSE 4000
CMD ["node", "gateway/src/server.js"]
