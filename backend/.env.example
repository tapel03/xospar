# Copy to .env and fill in. These keys live ONLY on the server, never in the mobile app.
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Market data providers (a provider with no key is simply switched off)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
# Binance public streams need no key
ENABLE_BINANCE=true

# News (GDELT is keyless)
NEWS_TIMESPAN=6h
NEWS_CACHE_SECONDS=120

# AI: Anthropic is preferred if its key is set, otherwise Free.ai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024
FREE_AI_API_KEY=
AI_DAILY_QUOTA=60

# User accounts and journals (SQLite file, created on first run). ':memory:' for a throwaway run.
DATA_FILE=data/edgeline.db
# New accounts start with the sample journal (8 trades, 3 strategies, alerts). Set false for production.
SEED_SAMPLE_DATA=true

# Economic calendar (Forex Factory weekly feed, no key)
# CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_CACHE_SECONDS=1800

# Rate limit per IP per minute
RATE_LIMIT_PER_MINUTE=120

# Provider base URLs (override only for tests or proxies)
# TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# FINNHUB_BASE_URL=https://finnhub.io/api/v1
# FINNHUB_WS_URL=wss://ws.finnhub.io
# BINANCE_WS_URL=wss://stream.binance.com:9443/stream
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
